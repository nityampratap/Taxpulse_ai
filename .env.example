# ==============================================================================
# TaxPulse AI - Environment Configuration Template (.env.example)
# Copy this file to .env and populate with your actual credentials.
# NOTE: Never commit .env or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER CONFIGURATION (FastAPI Backend)
# ------------------------------------------------------------------------------
ENVIRONMENT=development                # development | staging | production
APP_NAME=TaxPulse AI
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-in-production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# Primary: PostgreSQL (e.g. Neon, Supabase, RDS, local Postgres)
# Fallback: SQLite for zero-config local development
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taxpulse
SQLITE_FALLBACK_URL=sqlite:///./taxpulse.db
DB_ECHO=False

# ------------------------------------------------------------------------------
# 3. SUPABASE AUTH & DATA
# Frontend/Client-side: Safe to expose anon/publishable key (restricted by RLS)
# Backend/Server-side: Keep service_role/secret key strictly inside backend servers
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# Key Name: anon / publishable (starts with ey... or sb_publishable_...) - Safe for browser
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Key Name: service_role / secret (starts with ey... or sb_secret_...) - Backend ONLY
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# 4. AI & LLM PROVIDER APIS
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ------------------------------------------------------------------------------
# 5. FRONTEND CLIENT-SIDE VARIABLES (Vite / React)
# Must be prefixed with VITE_ to be exposed to the browser build.
# NEVER include backend secrets or service_role keys here!
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=TaxPulse AI
VITE_ENV=development
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
